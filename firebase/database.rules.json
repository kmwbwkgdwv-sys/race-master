{
  "rules": {
    ".read": false,
    ".write": false,
    "secrets": {
      "$pid": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "codes": {
      "$hash": {
        ".read": "auth != null",
        ".write": "auth != null && newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || newData.child('playerId').val() === data.child('playerId').val())",
        ".validate": "$hash.length === 64 && newData.hasChildren(['playerId', 'uid'])",
        "playerId": {
          ".validate": "newData.isString() && newData.val().length === 32"
        },
        "uid": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "profiles": {
      "$pid": {
        ".read": true,
        ".write": "auth != null && root.child('codes').child(root.child('secrets').child($pid).val()).child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['name', 'icon'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "icon": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "parts": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "playSec": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "icons": {
      "$pid": {
        ".read": true,
        ".write": "auth != null && root.child('codes').child(root.child('secrets').child($pid).val()).child('uid').val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length <= 30000"
      }
    },
    "rankings": {
      "$stageId": {
        ".read": true,
        ".indexOn": [
          "lapMs"
        ],
        "$pid": {
          ".write": "auth != null && root.child('codes').child(root.child('secrets').child($pid).val()).child('uid').val() === auth.uid && newData.exists() && (!data.exists() || newData.child('lapMs').val() <= data.child('lapMs').val())",
          ".validate": "newData.hasChildren(['name', 'icon', 'lapMs', 'achievedAt', 'mode'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "icon": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "lapMs": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 12000 && newData.val() <= 600000 && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway')"
          },
          "achievedAt": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "mode": {
            ".validate": "newData.val() === 'time_attack' || newData.val() === 'vs'"
          },
          "shortcuts": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        ".validate": "$roomId.matches(/^[A-Z2-9]{6}$/) && newData.hasChildren(['hostUid', 'maxPlayers', 'createdAt'])",
        "hostUid": {
          ".validate": "newData.isString()"
        },
        "maxPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
        },
        "createdAt": {
          ".validate": "newData.val() <= now"
        },
        "stageId": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "laps": {
          ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 5"
        },
        "items": {
          ".validate": "newData.val() === 0 || newData.val() === 1"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostUid').exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.val() <= now"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "kt": {
              ".validate": "newData.isNumber()"
            },
            "col": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "pv": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "start": {
          ".validate": "newData.hasChildren(['stageId', 'aiCount', 'seed', 'nonce'])",
          "stageId": {
            ".validate": "newData.isString()"
          },
          "aiCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
          },
          "seed": {
            ".validate": "newData.isNumber()"
          },
          "nonce": {
            ".validate": "newData.val() === now"
          },
          "order": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "tod": {
            ".validate": "newData.val() === 'day' || newData.val() === 'night'"
          },
          "rnd": {
            ".validate": "newData.isNumber()"
          },
          "laps": {
            ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 5"
          },
          "items": {
            ".validate": "newData.val() === 0 || newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "pos": {
          "$id": {
            ".write": "auth != null && data.parent().parent().child('hostUid').exists() && ($id === auth.uid || data.parent().parent().child('hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['x', 'z', 'h'])"
          }
        },
        "ev": {
          "$e": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['k', 'from']) && newData.child('from').val() === auth.uid"
          }
        },
        "chat": {
          "$m": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['from', 'name', 'text', 'at']) && newData.child('from').val() === auth.uid",
            "from": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "rankings_v2": {
      "$stageId": {
        ".read": true,
        ".indexOn": [
          "lapMs"
        ],
        "$pid": {
          ".write": "auth != null && root.child('codes').child(root.child('secrets').child($pid).val()).child('uid').val() === auth.uid && newData.exists() && (!data.exists() || newData.child('lapMs').val() <= data.child('lapMs').val())",
          ".validate": "newData.hasChildren(['name', 'icon', 'lapMs', 'achievedAt', 'mode'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "icon": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "lapMs": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 15000 && newData.val() <= 600000 && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway')"
          },
          "achievedAt": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "mode": {
            ".validate": "newData.val() === 'time_attack'"
          },
          "shortcuts": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "replays": {
      "$stageId": {
        "$pid": {
          ".read": true,
          ".write": "auth != null && root.child('codes').child(root.child('secrets').child($pid).val()).child('uid').val() === auth.uid && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway')",
          ".validate": "newData.hasChildren(['d', 'ms'])",
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 60000"
          },
          "ms": {
            ".validate": "newData.isNumber()"
          },
          "kt": {
            ".validate": "newData.isNumber()"
          },
          "col": {
            ".validate": "newData.isNumber()"
          },
          "ch": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "skins": {
      "$code": {
        ".read": true,
        ".write": "auth != null && !data.exists()",
        ".validate": "$code.matches(/^[A-Z2-9]{8}$/) && newData.hasChildren(['t', 'n', 'd'])",
        "t": {
          ".validate": "newData.val() === 'car' || newData.val() === 'ch'"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 200000 && newData.val().beginsWith('data:image/')"
        },
        "b": {
          ".validate": "newData.isNumber()"
        },
        "h": {
          ".validate": "newData.isNumber()"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "matches": {
      "$pid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$mid": {
          ".write": "auth != null && root.child('codes').child(root.child('secrets').child($pid).val()).child('uid').val() === auth.uid && !data.exists()",
          ".validate": "newData.hasChildren(['at', 'stage', 'n', 'rank'])",
          "at": {
            ".validate": "newData.val() === now"
          },
          "stage": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "mode": {
            ".validate": "newData.val() === 'vs' || newData.val() === 'online'"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
          },
          "hn": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
          },
          "rank": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
          },
          "laps": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "total": {
            ".validate": "newData.isNumber()"
          },
          "tod": {
            ".validate": "newData.val() === 'day' || newData.val() === 'night'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "paints": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "c": {
          ".validate": "newData.isString() && newData.val().length <= 200000"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length <= 200000"
        },
        "h": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rankings_v3": {
      "$stageId": {
        ".read": true,
        ".indexOn": [
          "lapMs",
          "pid"
        ],
        "$rid": {
          ".write": "auth != null && ((newData.exists() && root.child('codes').child(root.child('secrets').child(newData.child('pid').val()).val()).child('uid').val() === auth.uid && (!data.exists() || (data.child('pid').val() === newData.child('pid').val() && data.child('lapMs').val() === newData.child('lapMs').val()))) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
          ".validate": "newData.hasChildren(['pid', 'name', 'icon', 'lapMs', 'achievedAt', 'mode'])",
          "pid": {
            ".validate": "newData.isString() && newData.val().length === 32"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "icon": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "lapMs": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 25000 && newData.val() <= 600000 && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway')"
          },
          "achievedAt": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "mode": {
            ".validate": "newData.val() === 'time_attack'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "replays_v3": {
      "$stageId": {
        "$rid": {
          ".read": true,
          ".write": "auth != null && ((newData.exists() && !data.exists() && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway') && root.child('codes').child(root.child('secrets').child(root.child('rankings_v3').child($stageId).child($rid).child('pid').val()).val()).child('uid').val() === auth.uid) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
          ".validate": "newData.hasChildren(['d', 'ms'])",
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 80000"
          },
          "ms": {
            ".validate": "newData.isNumber()"
          },
          "kt": {
            ".validate": "newData.isNumber()"
          },
          "col": {
            ".validate": "newData.isNumber()"
          },
          "ch": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "roomlog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$mid": {
        ".write": "auth != null && !newData.exists() && root.child('admins').child(auth.uid).val() === true",
        "info": {
          ".write": "auth != null && !data.exists() && $mid.matches(/^[0-9]{13}_[A-Z2-9]{6}$/) && root.child('rooms').child(newData.child('room').val()).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['at', 'room', 'stage', 'n'])",
          "at": {
            ".validate": "newData.val() === now"
          },
          "room": {
            ".validate": "newData.isString() && newData.val().length === 6"
          },
          "stage": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "tod": {
            ".validate": "newData.val() === 'day' || newData.val() === 'night'"
          },
          "rnd": {
            ".validate": "newData.isNumber()"
          },
          "laps": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9"
          },
          "items": {
            ".validate": "newData.val() === 0 || newData.val() === 1"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
          },
          "ai": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
          },
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "pl": {
            "$uid": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "res": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && $mid.matches(/^[0-9]{13}_[A-Z2-9]{6}$/)",
            ".validate": "newData.hasChildren(['name', 'rank', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "rank": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
            },
            "total": {
              ".validate": "newData.isNumber()"
            },
            "laps": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rankings_v4": {
      "$stageId": {
        ".read": true,
        ".indexOn": [
          "lapMs",
          "pid"
        ],
        "$rid": {
          ".write": "auth != null && ((newData.exists() && root.child('codes').child(root.child('secrets').child(newData.child('pid').val()).val()).child('uid').val() === auth.uid && (!data.exists() || (data.child('pid').val() === newData.child('pid').val() && data.child('lapMs').val() === newData.child('lapMs').val()))) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
          ".validate": "newData.hasChildren(['pid', 'name', 'icon', 'lapMs', 'achievedAt', 'mode'])",
          "pid": {
            ".validate": "newData.isString() && newData.val().length === 32"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "icon": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "lapMs": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 40000 && newData.val() <= 900000 && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway')"
          },
          "achievedAt": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "mode": {
            ".validate": "newData.val() === 'time_attack' || newData.val() === 'room'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "replays_v4": {
      "$stageId": {
        "$rid": {
          ".read": true,
          ".write": "auth != null && ((newData.exists() && !data.exists() && ($stageId === 'master_circuit' || $stageId === 'neon_metropolis' || $stageId === 'ancient_desert' || $stageId === 'volcano_core' || $stageId === 'cosmo_skyway') && root.child('codes').child(root.child('secrets').child(root.child('rankings_v4').child($stageId).child($rid).child('pid').val()).val()).child('uid').val() === auth.uid) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
          ".validate": "newData.hasChildren(['d', 'ms'])",
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 120000"
          },
          "ms": {
            ".validate": "newData.isNumber()"
          },
          "kt": {
            ".validate": "newData.isNumber()"
          },
          "col": {
            ".validate": "newData.isNumber()"
          },
          "ch": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}